# Dependencies & Virtual Environments
.venv/
.vscode/
node_modules/
temp_build/

# Cache & Build artifacts
__pycache__/
.pytest_cache/
.agents/
audits/
tests/
*.pyc
*.pyo
*.pyd
*.log

# Git
.git/
.gitignore

# Uploaded Files (preserve directory structure via .gitkeep)
books/body/*
!books/body/.gitkeep
books/cover/*
!books/cover/.gitkeep

# Secrets (hanya izinkan requirements.txt jika diambil dari .secrets)
.secrets/*
!.secrets/requirements.txt

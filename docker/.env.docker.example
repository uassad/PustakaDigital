# Docker Compose Environment Configuration Example
# Copy or adjust variables directly in docker-compose.yml or use a .env file

ENVIRONMENT=development

# PostgreSQL Database Service
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@postgres:5432/uas_sad_website_buku
DB_SCHEMA=uas_sad

# JWT Secrets (min 32 chars)
JWT_SECRET_KEY=CHANiLj-uogPpf2MYpgCd-CQzKk9kDqS3J6LURSvPekgg9R3ZMQThiF-FyHZ1COgtnSRlIxsFubtbYAF5XHWor8tyEQ
PASSWORD_PEPPER=hD22R8u2jRd8RTh9z0Bgczy1Gb4CITPiR9UvGtOYiRDIKTR7k1r5GnNqcwmhj8UNbzn3-iZNbFlPtNJgic4kDw

# CORS & Hosts
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# MongoDB Activity Log Service
ACTIVITY_LOG_ENABLED=true
MONGODB_URI=mongodb://mongodb:27017

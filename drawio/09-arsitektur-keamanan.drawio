<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="arsitektur-keamanan" name="Arsitektur Keamanan">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1360" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="client-zone" value="Batas kepercayaan 1 - Klien dan peramban" style="swimlane;html=1;startSize=30;horizontal=1;collapsible=0;container=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1540" height="160" as="geometry"/></mxCell>
        <mxCell id="edge-zone" value="Batas kepercayaan 2 - Perimeter dan transport" style="swimlane;html=1;startSize=30;horizontal=1;collapsible=0;container=1;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1540" height="190" as="geometry"/></mxCell>
        <mxCell id="app-zone" value="Batas kepercayaan 3 - Aplikasi dan layanan internal" style="swimlane;html=1;startSize=30;horizontal=1;collapsible=0;container=1;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="1540" height="450" as="geometry"/></mxCell>
        <mxCell id="data-zone" value="Batas kepercayaan 4 - Data, berkas, dan konfigurasi rahasia" style="swimlane;html=1;startSize=30;horizontal=1;collapsible=0;container=1;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="1540" height="300" as="geometry"/></mxCell>
        <mxCell id="browser" value="Peramban&#xa;CSP ketat; skrip dari sumber sendiri; teks DOM aman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="client-zone"><mxGeometry x="70" y="55" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="token-client" value="Token pembaca di sessionStorage&#xa;Dikirim sebagai Bearer; tidak ditempatkan di URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="client-zone"><mxGeometry x="480" y="55" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="caddy" value="Caddy reverse proxy&#xa;HTTPS/TLS sesuai konfigurasi deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="edge-zone"><mxGeometry x="80" y="55" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="http-guards" value="FastAPI middleware&#xa;TrustedHost, CORS allowlist, CSP/header keamanan, batas ukuran, tanpa cache API/HTML" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="edge-zone"><mxGeometry x="430" y="45" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="api-auth" value="Autentikasi&#xa;JWT algoritma/claim dibatasi; kedaluwarsa pendek; peran dibaca ulang dari basis data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="app-zone"><mxGeometry x="50" y="55" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="authorization" value="Otorisasi server&#xa;RBAC deny-by-default; pemeriksaan pemilik; larangan akses BOLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="app-zone"><mxGeometry x="430" y="55" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="admin-cookie" value="Sesi administrator&#xa;Cookie HttpOnly, SameSite Strict, jalur terbatas; Secure saat produksi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="app-zone"><mxGeometry x="800" y="55" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="password-otp" value="Kredensial dan OTP&#xa;Hash Argon2id + pepper; OTP HMAC, kedaluwarsa, maksimal 5 percobaan; OTP simulasi hanya development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="app-zone"><mxGeometry x="1180" y="55" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="api-data" value="Akses data dan input&#xa;ORM/kueri berparameter; validasi ISBN/pencarian; respons validasi tidak memantulkan rahasia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app-zone"><mxGeometry x="50" y="230" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="file-guard" value="Pertahanan unggah dan path&#xa;PDF/JPG, tanda tangan isi, batas ukuran, nama acak, direktori terkunci; bekukan setelah 4 kegagalan harian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app-zone"><mxGeometry x="430" y="220" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="audit-sanitize" value="Audit keamanan&#xa;Buang password/token/OTP dan bersihkan teks; log 401/403/429; pencatatan gagal tidak menggagalkan request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="app-zone"><mxGeometry x="850" y="220" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="rate-limit" value="Pembatas laju&#xa;Per alamat IP dan akun; penyimpanan in-memory per proses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="app-zone"><mxGeometry x="1220" y="230" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="config-secret" value="Konfigurasi environment / .env&#xa;JWT secret dan pepper minimal 32 karakter; validasi gagal menghentikan startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="data-zone"><mxGeometry x="50" y="60" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="postgres" value="PostgreSQL&#xa;Akun runtime bukan migrator; parameter tersembunyi; batas waktu query; TLS wajib produksi" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="data-zone"><mxGeometry x="430" y="50" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="file-store" value="Direktori buku&#xa;Path tervalidasi, tanpa traversal; nama berkas diizinkan saja" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="data-zone"><mxGeometry x="820" y="60" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="mongo" value="MongoDB log&#xa;Rincian sudah dibersihkan; koneksi gagal ditangani sebagai fail-open" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="data-zone"><mxGeometry x="1180" y="50" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="mailpit" value="Mailpit&#xa;Kotak masuk lokal; bukan operator SMS" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="data-zone"><mxGeometry x="820" y="185" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="sec1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="browser" target="caddy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec2" value="Bearer token / permintaan same-origin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="token-client" target="http-guards"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec3" value="Permintaan reverse proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="caddy" target="http-guards"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec4" value="Hitungan pembatas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="http-guards" target="rate-limit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec5" value="Permintaan sesuai batas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="rate-limit" target="api-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec6" value="Verifikasi identitas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="api-auth" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec7" value="Peran dan kepemilikan dari basis data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="postgres" target="authorization"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec8" value="Izin untuk proses sensitif" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="authorization" target="api-data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec9" value="Periksa kata sandi dan hash OTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="api-auth" target="password-otp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec10" value="Cookie sesi khusus admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="admin-cookie" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec11" value="Kredensial rahasia hanya untuk aplikasi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;" edge="1" parent="1" source="config-secret" target="api-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec12" value="Query parameterized" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="api-data" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec13" value="Validasi dan tulis/ambil berkas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="file-guard" target="file-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec16" value="Permintaan unggah dan baca berkas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="api-data" target="file-guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec14" value="Peristiwa yang disanitasi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="audit-sanitize" target="mongo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec15" value="OTP untuk verifikasi lokal development" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;dashed=1;" edge="1" parent="1" source="password-otp" target="mailpit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sec17" value="Hash kata sandi/OTP dan penghitung kegagalan; tanpa OTP mentah" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;" edge="1" parent="1" source="password-otp" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="Keterangan zona" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1160" width="1080" height="100" as="geometry"/></mxCell>
        <mxCell id="legend-client" value="Klien tidak tepercaya" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="legend"><mxGeometry x="20" y="40" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="legend-edge" value="Gerbang dan transport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="legend"><mxGeometry x="280" y="40" width="230" height="40" as="geometry"/></mxCell>
        <mxCell id="legend-app" value="Layanan aplikasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend"><mxGeometry x="550" y="40" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="legend-data" value="Data terlindungi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend"><mxGeometry x="790" y="40" width="200" height="40" as="geometry"/></mxCell>

# Salin ke ".env" lalu isi. JANGAN commit file .env.
ENVIRONMENT=development

# Login role RUNTIME (anggota grp_uas_sad_rw) — BUKAN uas_sad_migrator / postgres.
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/uas_sad_website_buku
# Produksi: verify-full (atau minimal require). Development lokal: kosongkan.
# DATABASE_SSLMODE=verify-full
DB_SCHEMA=uas_sad

# Hasilkan dengan:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# (dua nilai BERBEDA, masing-masing >= 32 karakter)
JWT_SECRET_KEY=CHANiLj-uogPpf2MYpgCd-CQzKk9kDqS3J6LURSvPekgg9R3ZMQThiF-FyHZ1COgtnSRlIxsFubtbYAF5XHWor8tyEQ
PASSWORD_PEPPER=hD22R8u2jRd8RTh9z0Bgczy1Gb4CITPiR9UvGtOYiRDIKTR7k1r5GnNqcwmhj8UNbzn3-iZNbFlPtNJgic4kDw
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origin front-end yang diizinkan (dipisah koma, TANPA wildcard dan TANPA slash di akhir).
